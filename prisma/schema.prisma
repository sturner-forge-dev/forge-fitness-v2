generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id               Int      @id @default(autoincrement())
  name             String
  force            String?
  level            String
  mechanic         String?
  equipment        String?
  primaryMuscles   String[]
  secondaryMuscles String[]
  instructions     String[]
  category         String
  images           String[]
  createdAt        DateTime @default(now())
}
